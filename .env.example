# Copy this file to .env.local and fill in values. Never commit .env.local.

# Public URL of the deployed site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Defaults to https://nesdaycoconutscraper.in when not set.
NEXT_PUBLIC_SITE_URL=https://nesdaycoconutscraper.in

# Optional: port used by Playwright end-to-end tests (default 3100).
# PLAYWRIGHT_PORT=3100

# Not used yet. Reserved for a future enquiry form (see PROJECT_DOCUMENTATION.md, section 21).
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=
# ENQUIRY_FROM_EMAIL=
